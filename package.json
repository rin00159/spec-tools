{
	"name": "spec-tools",
	"version": "1.0.1",
	"description": "Zero-dependency CLI for spec-driven project management and AI collaboration",
	"keywords": [
		"spec",
		"spec-driven",
		"cli",
		"ai",
		"ai-collaboration",
		"project-management",
		"scaffold",
		"coverage",
		"documentation",
		"markdown",
		"lint",
		"decision-log",
		"adr",
		"typescript",
		"zero-dependencies"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"spec-tools": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"templates",
		"docs/instruction"
	],
	"scripts": {
		"prepublishOnly": "pnpm verify",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
		"prepare": "pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"@types/node": "^26.1.1"
	},
	"author": "Rintaro Osumi <0sumirintaro@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/rin00159/spec-tools#readme",
	"bugs": {
		"url": "https://github.com/rin00159/spec-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rin00159/spec-tools.git"
	}
}
